# Required for all persistent/staging/production deployments. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
REALITY_API_SECRET=
REALITY_ENV=development
POSTGRES_PASSWORD=
# Set a URL with the same PostgreSQL password (URL-encode special characters).
REALITY_DATABASE_URL=
REALITY_STORAGE_BACKEND=local
REALITY_STORAGE_ROOT=/var/lib/reality/objects
REALITY_CORS_ORIGINS=http://localhost:3000
REALITY_MAX_UPLOAD_BYTES=536870912
REALITY_SYNC_ANALYSIS_BYTES=16777216
REALITY_RATE_LIMIT_PER_MINUTE=120
REALITY_DEFAULT_QUOTA_BYTES=5368709120
# Required for mobile-number sign-in through real SMS delivery.
REALITY_TWILIO_ACCOUNT_SID=
REALITY_TWILIO_AUTH_TOKEN=
REALITY_TWILIO_VERIFY_SERVICE_SID=
# To use S3/MinIO, set REALITY_STORAGE_BACKEND=s3 plus:
# REALITY_S3_BUCKET=reality-objects
# REALITY_S3_ENDPOINT_URL=http://minio:9000
